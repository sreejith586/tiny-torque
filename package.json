{
  "name": "mini-vault",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=mobile --project=desktop",
    "gen:types": "supabase gen types typescript --local --schema public > src/types/supabase.ts",
    "gen:types:db": "supabase gen types typescript --db-url \"${DATABASE_URL}?sslmode=disable\" --schema public > src/types/supabase.ts",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "guard": "bash docs/plan/tools/guard.sh",
    "analyze": "node scripts/bundle-report.mjs",
    "a11y:contrast": "node scripts/contrast-check.mjs",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts --project=mobile --project=desktop",
    "test:e2e:matrix": "THEME_MATRIX=1 playwright test e2e/theme-matrix.spec.ts --project=desktop",
    "lighthouse": "npx --yes @lhci/cli@0.14.0 autorun --collect.url=http://127.0.0.1:3000/ --collect.url=http://127.0.0.1:3000/login --collect.url=http://127.0.0.1:3000/market?__visual=1 --collect.url=http://127.0.0.1:3000/garage?__visual=1",
    "plan:render": "python3 docs/plan/tools/render.py",
    "prepare": "husky",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "papaparse": "^5.7.0",
    "posthog-js": "^1.447.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-4r6h-8v6p-xvw6",
        "GHSA-5pgg-2g8v-p4x9"
      ]
    }
  }
}
