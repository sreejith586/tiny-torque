# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Environment label: development | preview | staging | production ---
NEXT_PUBLIC_APP_ENV=development

# --- Observability (optional locally; required on staging/prod) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Local DB validation without Docker (scripts/db-validate.sh) ---
# DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
