{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 docs/plan/tools/render.py)",
      "Bash(bash docs/plan/tools/guard.sh)",
      "Bash(bash scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin sprint-*)",
      "Bash(git push -u origin sprint-*)",
      "Bash(git push origin mv/*)",
      "Bash(git push -u origin mv/*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git stash*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin staging*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf *)",
      "Bash(supabase db push*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(vercel *)",
      "Read(./.env*)",
      "Read(./supabase/.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/session-start.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/protect-decisions.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/stop-guard.sh" }]
      }
    ]
  }
}
